<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="using:Avalonia.Automation"
        x:Class="Robin.AboutWindow"
        XYFocus.NavigationModes="Keyboard"
        Width="420"
        Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="28" Spacing="12">
        <TextBlock x:Name="aboutTitle"
                   automation:AutomationProperties.HeadingLevel="1"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock x:Name="aboutVersion"
                   Classes="label" />
        <TextBlock x:Name="aboutDescription"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="aboutTechnology"
                   Classes="label" />
        <TextBlock x:Name="aboutCopyright"
                   Classes="label" />
        <TextBlock x:Name="aboutLicense"
                   Classes="label" />
        <Button x:Name="buyMeACoffeeButton"
                Click="BuyMeACoffee_OnClick"
                HorizontalAlignment="Left" />
        <Button x:Name="closeButton"
                Click="Close_OnClick"
                HorizontalAlignment="Right" />
    </StackPanel>
</Window>